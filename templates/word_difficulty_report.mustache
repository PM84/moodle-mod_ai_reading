{{!
    @template mod_aireading/word_difficulty_report

    Teacher report showing word difficulty analysis based on pronunciation

    Context variables:
    * words - Array of word difficulty data
    * totalwords - Total number of unique words analyzed
}}

<div class="ai-reading-word-difficulty-report">

    <div class="report-header mb-3">
        <h3>{{#str}}word_difficulty_report, mod_aireading{{/str}}</h3>
        <p class="text-muted">{{#str}}word_difficulty_report_desc, mod_aireading{{/str}}</p>
        <p><strong>{{#str}}total_attempts, mod_aireading{{/str}}:</strong> {{totalwords}}</p>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>{{#str}}word, mod_aireading{{/str}}</th>
                    <th class="text-center">{{#str}}avg_confidence, mod_aireading{{/str}}</th>
                    <th class="text-center">{{#str}}students_affected, mod_aireading{{/str}}</th>
                    <th class="text-center">{{#str}}total_attempts, mod_aireading{{/str}}</th>
                    <th class="text-center">{{#str}}difficulty_level, mod_aireading{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#words}}
                <tr>
                    <td><strong>{{word}}</strong></td>
                    <td class="text-center">
                        <span class="badge badge-{{difficulty_class}}">
                            {{avgconfidence_percent}}%
                        </span>
                    </td>
                    <td class="text-center">{{studentcount}}</td>
                    <td class="text-center">{{totalattempts}}</td>
                    <td class="text-center">
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar bg-{{difficulty_class}}"
                                 role="progressbar"
                                 style="width: {{difficultypercent}}%"
                                 aria-valuenow="{{difficultypercent}}"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                {{difficultypercent}}%
                            </div>
                        </div>
                    </td>
                </tr>
                {{/words}}
            </tbody>
        </table>
    </div>

    <div class="report-legend mt-3">
        <h5>{{#str}}legend, mod_aireading{{/str}}</h5>
        <ul class="list-unstyled">
            <li><span class="badge badge-danger"></span> {{#str}}very_difficult, mod_aireading{{/str}} (≥50% students struggle)</li>
            <li><span class="badge badge-warning"></span> {{#str}}moderately_difficult, mod_aireading{{/str}} (25-49% students struggle)</li>
            <li><span class="badge badge-success"></span> {{#str}}easy, mod_aireading{{/str}} (&lt;25% students struggle)</li>
        </ul>
    </div>

    <div class="report-recommendations mt-4 card">
        <div class="card-body">
            <h5>{{#str}}teaching_recommendations, mod_aireading{{/str}}</h5>
            <ul>
                <li>{{#str}}recommendation_focus_difficult, mod_aireading{{/str}}</li>
                <li>{{#str}}recommendation_practice_sessions, mod_aireading{{/str}}</li>
                <li>{{#str}}recommendation_peer_support, mod_aireading{{/str}}</li>
            </ul>
        </div>
    </div>

</div>
