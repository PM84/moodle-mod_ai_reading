{{!
    @template mod_aireading/recorder

    Audio recorder interface

    Context variables:
    * cmid - Course module ID
    * aireadingid - AI Reading instance ID
    * silencethreshold - Silence threshold in seconds
    * maxduration - Maximum recording duration in seconds
}}
<div class="aireading-recorder" id="aireading-recorder-container">
    <div class="recorder-controls">
        <button id="aireading-start-recording" class="btn btn-success btn-lg" role="button" aria-label="{{#str}}startrecording, mod_aireading{{/str}}">
            <i class="fa fa-microphone"></i> {{#str}}startrecording, mod_aireading{{/str}}
        </button>
        <button id="aireading-pause-recording" class="btn btn-warning" style="display: none;" role="button" aria-label="{{#str}}pauserecording, mod_aireading{{/str}}">
            <i class="fa fa-pause"></i> {{#str}}pause, mod_aireading{{/str}}
        </button>
        <button id="aireading-resume-recording" class="btn btn-info" style="display: none;" role="button" aria-label="{{#str}}resumerecording, mod_aireading{{/str}}">
            <i class="fa fa-play"></i> {{#str}}resume, mod_aireading{{/str}}
        </button>
        <button id="aireading-stop-recording" class="btn btn-danger" style="display: none;" role="button" aria-label="{{#str}}stoprecording, mod_aireading{{/str}}">
            <i class="fa fa-stop"></i> {{#str}}stop, mod_aireading{{/str}}
        </button>
    </div>

    <div class="recorder-info mt-3">
        <div class="timer-display">
            <i class="fa fa-clock-o"></i> <span id="aireading-timer">00:00</span>
        </div>
        <div class="status-display mt-2" aria-live="polite" aria-atomic="true">
            <span id="aireading-status">{{#str}}ready, mod_aireading{{/str}}</span>
        </div>
    </div>

    <div class="waveform-container mt-3" id="aireading-waveform">
        <canvas id="aireading-canvas" width="600" height="100"></canvas>
    </div>
</div>

{{#js}}
require(['mod_aireading/recorder'], function(Recorder) {
    Recorder.init({
        cmid: {{cmid}},
        aireadingid: {{aireadingid}},
        silencethreshold: {{silencethreshold}},
        maxduration: {{maxduration}},
        wwwroot: M.cfg.wwwroot,
        sesskey: M.cfg.sesskey
    });
});
{{/js}}
