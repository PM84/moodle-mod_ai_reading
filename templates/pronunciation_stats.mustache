{{!
    @template mod_aireading/pronunciation_stats

    Displays pronunciation statistics panel when pronunciation assessment is enabled

    Context variables:
    * avgconfidence - Average confidence score (0-100)
    * minconfidence - Minimum required confidence (0-100)
    * has_word_scores - Whether word-level scores are available
    * worst_words - Array of worst pronounced words [{word, confidence, class}]
    * best_words - Array of best pronounced words [{word, confidence}]
    * has_focus_words - Whether focus words are available
    * focus_words - Array of words needing practice [{word}]
}}

<div class="ai-reading-pronunciation-stats">

    <h4>{{#str}}pronunciation_assessment, mod_aireading{{/str}}</h4>

    {{! Overall pronunciation score }}
    <div class="pronunciation-summary mb-3">
        <div class="row">
            <div class="col-md-6">
                <div class="stat-box">
                    <div class="stat-label">{{#str}}avg_confidence, mod_aireading{{/str}}</div>
                    <div class="stat-value">
                        <span class="confidence-score">{{avgconfidence}}%</span>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="stat-box">
                    <div class="stat-label">{{#str}}required_confidence, mod_aireading{{/str}}</div>
                    <div class="stat-value">
                        <span class="confidence-threshold">{{minconfidence}}%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{! Word-level breakdown }}
    {{#has_word_scores}}
    <div class="word-breakdown mb-3">
        <div class="row">

            {{! Words needing most practice }}
            <div class="col-md-6">
                <h5 class="text-danger">{{#str}}needs_practice, mod_aireading{{/str}}</h5>
                <ul class="word-list">
                    {{#worst_words}}
                    <li class="word-item">
                        <span class="word-text pronunciation-{{class}}">{{word}}</span>
                        <span class="word-confidence badge badge-{{class}}">{{confidence}}%</span>
                    </li>
                    {{/worst_words}}
                </ul>
            </div>

            {{! Best pronounced words }}
            <div class="col-md-6">
                <h5 class="text-success">{{#str}}well_pronounced, mod_aireading{{/str}}</h5>
                <ul class="word-list">
                    {{#best_words}}
                    <li class="word-item">
                        <span class="word-text">{{word}}</span>
                        <span class="word-confidence badge badge-success">{{confidence}}%</span>
                    </li>
                    {{/best_words}}
                </ul>
            </div>

        </div>
    </div>
    {{/has_word_scores}}

    {{! Focus words (words to practice) }}
    {{#has_focus_words}}
    <div class="focus-words-section mb-3">
        <div class="alert alert-info">
            <h5>{{#str}}words_to_practice, mod_aireading{{/str}}</h5>
            <p class="mb-2">{{#str}}focus_words_explanation, mod_aireading{{/str}}</p>
            <div class="focus-words-list">
                {{#focus_words}}
                <span class="badge badge-primary mr-1 mb-1">{{word}}</span>
                {{/focus_words}}
            </div>
        </div>
    </div>
    {{/has_focus_words}}

    {{! Pronunciation legend }}
    <div class="pronunciation-legend">
        <h5>{{#str}}confidence_scale, mod_aireading{{/str}}</h5>
        <ul class="legend-items">
            <li>
                <span class="legend-marker bg-success"></span>
                {{#str}}good_pronunciation, mod_aireading{{/str}}
                <small class="text-muted">(≥ {{minconfidence}}%)</small>
            </li>
            <li>
                <span class="legend-marker bg-warning"></span>
                {{#str}}acceptable_pronunciation, mod_aireading{{/str}}
                <small class="text-muted">({{minconfidence_lower}}% - {{minconfidence}}%)</small>
            </li>
            <li>
                <span class="legend-marker bg-danger"></span>
                {{#str}}poor_pronunciation, mod_aireading{{/str}}
                <small class="text-muted">(&lt; {{minconfidence_lower}}%)</small>
            </li>
        </ul>
    </div>

    {{! Note about accent variations }}
    <div class="pronunciation-note mt-3">
        <small class="text-muted">
            <i class="fa fa-info-circle"></i>
            {{#str}}pronunciation_note, mod_aireading{{/str}}
        </small>
    </div>

</div>
