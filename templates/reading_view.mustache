{{!
    @template mod_aireading/reading_view

    Main reading practice view for students

    Context variables:
    * readingtext - The text to read (formatted HTML)
    * recorder - Recorder interface data
    * attempts - Array of previous attempts
    * canattempt - Boolean if user can make new attempts
    * maxattempts - Maximum allowed attempts
    * attemptsused - Number of attempts already made
}}
<div class="mod-aireading-reading-view">
    {{#canattempt}}
        <div class="alert alert-info">
            {{#str}}attemptsinfo, mod_aireading, {"used": {{attemptsused}}, "max": {{maxattempts}} }{{/str}}
        </div>
    {{/canattempt}}
    {{^canattempt}}
        <div class="alert alert-warning">
            {{#str}}maxattemptsreached, mod_aireading{{/str}}
        </div>
    {{/canattempt}}

    <div class="reading-text-section mb-4">
        <h3>{{#str}}readingtext, mod_aireading{{/str}}</h3>
        <div class="reading-text-content border p-3 bg-light">
            {{{readingtext}}}
        </div>
    </div>

    {{#canattempt}}
        <div class="recorder-section mb-4">
            <h3>{{#str}}recordyourreading, mod_aireading{{/str}}</h3>
            {{> mod_aireading/recorder }}
        </div>
    {{/canattempt}}

    {{#hasattempts}}
        <div class="attempts-section mt-5">
            <h3>{{#str}}yourattempts, mod_aireading{{/str}}</h3>
            <div class="attempts-list">
                {{#attempts}}
                    {{> mod_aireading/attempt_row }}
                {{/attempts}}
            </div>
        </div>
    {{/hasattempts}}
</div>
