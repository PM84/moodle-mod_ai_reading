{{!
    @template mod_aireading/attempt_results

    Displays reading attempt results with feedback and statistics

    Context variables:
    * attemptid - Attempt ID
    * attemptnumber - Attempt number
    * timestarted - Start time (formatted)
    * timefinished - Finish time (formatted)
    * duration - Duration (formatted)
    * wpm - Words per minute
    * targetwpm - Target WPM
    * accuracy - Accuracy score (0-100)
    * fluency - Fluency score (0-100)
    * pronunciation - Pronunciation score (0-100, optional)
    * grade - Final grade
    * haspronunciation - Whether pronunciation is enabled
    * beginnermode - Whether beginner mode is active
    * annotatedtext - HTML with annotated text
    * audioplayer - HTML for audio player
    * statistics - HTML for statistics
    * pronunciationstats - HTML for pronunciation panel (optional)
    * teacherfeedback - Teacher feedback (optional)
}}

<div class="ai-reading-attempt-results" data-attemptid="{{attemptid}}">

    {{! Header with attempt info }}
    <div class="attempt-header card mb-3">
        <div class="card-body">
            <h3 class="card-title">
                {{#str}}attempt_number, mod_aireading, {{attemptnumber}}{{/str}}
            </h3>
            <div class="attempt-meta">
                <p class="mb-1">
                    <strong>{{#str}}started, mod_aireading{{/str}}:</strong> {{timestarted}}
                </p>
                <p class="mb-1">
                    <strong>{{#str}}finished, mod_aireading{{/str}}:</strong> {{timefinished}}
                </p>
                <p class="mb-0">
                    <strong>{{#str}}duration, mod_aireading{{/str}}:</strong> {{duration}}
                </p>
            </div>
        </div>
    </div>

    {{! Overall scores }}
    <div class="attempt-scores card mb-3">
        <div class="card-body">
            <h4 class="card-title">{{#str}}overall_scores, mod_aireading{{/str}}</h4>
            <div class="row">
                <div class="col-md-3">
                    <div class="score-card">
                        <div class="score-label">{{#str}}wpm_label, mod_aireading{{/str}}</div>
                        <div class="score-value {{#wpm_percentage}}wpm-{{wpm_percentage}}{{/wpm_percentage}}">
                            {{wpm}} / {{targetwpm}}
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="score-card">
                        <div class="score-label">{{#str}}accuracy_label, mod_aireading{{/str}}</div>
                        <div class="score-value score-{{accuracy}}">{{accuracy}}%</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="score-card">
                        <div class="score-label">{{#str}}fluency_label, mod_aireading{{/str}}</div>
                        <div class="score-value score-{{fluency}}">{{fluency}}%</div>
                    </div>
                </div>
                {{#haspronunciation}}
                <div class="col-md-3">
                    <div class="score-card">
                        <div class="score-label">{{#str}}pronunciation_label, mod_aireading{{/str}}</div>
                        <div class="score-value score-{{pronunciation}}">{{pronunciation}}%</div>
                    </div>
                </div>
                {{/haspronunciation}}
            </div>
            <div class="final-grade mt-3">
                <strong>{{#str}}final_grade, mod_aireading{{/str}}:</strong>
                <span class="grade-value">{{grade}}%</span>
            </div>
        </div>
    </div>

    {{! Audio player }}
    <div class="attempt-audio card mb-3">
        <div class="card-body">
            <h4 class="card-title">{{#str}}your_recording, mod_aireading{{/str}}</h4>
            {{{audioplayer}}}
        </div>
    </div>

    {{! Annotated text with errors }}
    <div class="attempt-feedback card mb-3">
        <div class="card-body">
            <h4 class="card-title">{{#str}}reading_feedback, mod_aireading{{/str}}</h4>
            {{#beginnermode}}
            <div class="alert alert-info">
                {{#str}}beginner_mode_info, mod_aireading{{/str}}
            </div>
            {{/beginnermode}}
            {{{annotatedtext}}}
        </div>
    </div>

    {{! Pronunciation statistics (if enabled) }}
    {{#pronunciationstats}}
    <div class="pronunciation-panel card mb-3">
        <div class="card-body">
            {{{pronunciationstats}}}
        </div>
    </div>
    {{/pronunciationstats}}

    {{! Statistics }}
    <div class="attempt-statistics card mb-3">
        <div class="card-body">
            <h4 class="card-title">{{#str}}statistics, mod_aireading{{/str}}</h4>
            {{{statistics}}}
        </div>
    </div>

    {{! Teacher feedback (if present) }}
    {{#teacherfeedback}}
    <div class="teacher-feedback card mb-3">
        <div class="card-body">
            <h4 class="card-title">{{#str}}teacher_feedback, mod_aireading{{/str}}</h4>
            <div class="feedback-content">
                {{{teacherfeedback}}}
            </div>
        </div>
    </div>
    {{/teacherfeedback}}

</div>

{{#js}}
require(['mod_aireading/results_viewer'], function(ResultsViewer) {
    ResultsViewer.init({
        minconfidence: {{minconfidence}},
        beginnermode: {{#beginnermode}}true{{/beginnermode}}{{^beginnermode}}false{{/beginnermode}}
    });
});
{{/js}}
